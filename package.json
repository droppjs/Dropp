{
  "name": "droppjs",
  "version": "0.2.0",
  "type": "module",
  "author": "Ribal Arshad",
  "license": "MIT",
  "description": "Node.js media library for file uploads, image management, and S3/R2 storage. Works with Next.js, Express, NestJS, Prisma, and ecommerce or SaaS apps.",
  "keywords": [
    "media-library",
    "media-management",
    "file-upload",
    "image-upload",
    "image-processing",
    "digital-asset-management",
    "nextjs",
    "express",
    "nestjs",
    "ecommerce",
    "saas",
    "cms",
    "s3",
    "cloudflare-r2",
    "prisma",
    "sharp",
    "multer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/droppjs/Dropp"
  },
  "homepage": "https://github.com/droppjs/Dropp#readme",
  "bugs": {
    "url": "https://github.com/droppjs/Dropp/issues"
  },
  "packageManager": "pnpm@10.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dropp": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin",
    "oclif.manifest.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./image": {
      "import": "./dist/transformer/image/index.js",
      "types": "./dist/transformer/image/index.d.ts"
    },
    "./video": {
      "import": "./dist/transformer/video/index.js",
      "types": "./dist/transformer/video/index.d.ts"
    },
    "./s3": {
      "import": "./dist/storage/s3/index.js",
      "types": "./dist/storage/s3/index.d.ts"
    },
    "./r2": {
      "import": "./dist/storage/r2/index.js",
      "types": "./dist/storage/r2/index.d.ts"
    },
    "./azure": {
      "import": "./dist/storage/azure/index.js",
      "types": "./dist/storage/azure/index.d.ts"
    },
    "./gcs": {
      "import": "./dist/storage/gcs/index.js",
      "types": "./dist/storage/gcs/index.d.ts"
    },
    "./queue": {
      "import": "./dist/queue/bullmq/index.js",
      "types": "./dist/queue/bullmq/index.d.ts"
    },
    "./watermark": {
      "import": "./dist/plugins/watermark/index.js",
      "types": "./dist/plugins/watermark/index.d.ts"
    },
    "./ai-tagging": {
      "import": "./dist/plugins/ai-tagging/index.js",
      "types": "./dist/plugins/ai-tagging/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run manifest",
    "manifest": "oclif manifest .",
    "dev": "tsx src/cli/index.ts",
    "test": "pnpm build && node ./scripts/smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist oclif.manifest.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@oclif/core": "^4.13.5",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.3.1",
    "mime-types": "^2.1.35",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@azure/storage-blob": "~12.33.0",
    "@google-cloud/storage": "^7.19.0",
    "@mikro-orm/core": "^6.6.10",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.71.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "kysely": "^0.28.17",
    "mongoose": "^8.24.1",
    "next": "^15.0.8 || ^16.2.6",
    "openai": "^4.104.0",
    "sequelize": "^6.37.0",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.31"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true },
    "@azure/storage-blob": { "optional": true },
    "@google-cloud/storage": { "optional": true },
    "@mikro-orm/core": { "optional": true },
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "@prisma/client": { "optional": true },
    "bullmq": { "optional": true },
    "drizzle-orm": { "optional": true },
    "express": { "optional": true },
    "ffmpeg-static": { "optional": true },
    "fluent-ffmpeg": { "optional": true },
    "kysely": { "optional": true },
    "mongoose": { "optional": true },
    "next": { "optional": true },
    "openai": { "optional": true },
    "sequelize": { "optional": true },
    "sharp": { "optional": true },
    "typeorm": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@azure/storage-blob": "~12.33.0",
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "bullmq": "^5.71.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.104.0",
    "sharp": "^0.35.3",
    "express": "^4.22.1",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.5.0",
    "multer": "^2.2.0",
    "next": "^16.3.1",
    "oclif": "^4.23.30",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "oclif": {
    "bin": "dropp",
    "commands": "./dist/cli/commands"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^2.1.4",
      "@tootallnate/once": "^3.0.1",
      "lodash": "^4.18.0",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "form-data": "^4.0.6",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6",
      "path-to-regexp@<0.2.0": "0.1.13",
      "uuid": "^11.1.1"
    }
  }
}
